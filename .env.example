# ================================================================
# HIREMIND AI - Environment Configuration
# ================================================================

# Flask Configuration
FLASK_APP=app.py
FLASK_DEBUG=True
FLASK_PORT=5000
SECRET_KEY=hiremind-ai-secret-key-change-in-production

# AI Provider Configuration
# Supported providers: "groq", "openai", "gemini", "openrouter", "ollama", "demo"
# If AI_API_KEY is blank, HireMind AI automatically runs in robust DEMO MODE!
AI_PROVIDER=groq

# Your API Key (leave empty for automatic instant DEMO MODE)
AI_API_KEY=

# Model Name (examples below):
# Groq: llama-3.3-70b-versatile OR llama-3.1-8b-instant
# OpenAI: gpt-4o-mini OR gpt-4o
# Gemini: gemini-1.5-flash
# Ollama: llama3.2
AI_MODEL=llama-3.3-70b-versatile

# Optional custom base URL (useful for Ollama or OpenRouter)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_BASE_URL=http://localhost:11434/v1
AI_BASE_URL=
